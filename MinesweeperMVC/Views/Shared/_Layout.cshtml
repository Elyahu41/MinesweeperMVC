<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · Minesweeper MVC</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="site-header">
        <nav class="nav container">
            <a class="brand" asp-controller="Home" asp-action="Index">💣 Minesweeper<span>MVC</span></a>
            <div class="nav-links">
                <a asp-controller="Home" asp-action="Index">Home</a>
                <a asp-controller="Game" asp-action="Index">Play</a>
                <a href="https://github.com/Elyahu41/MinesweeperMVC">GitHub</a>
            </div>
        </nav>
    </header>

    <main class="container">
        @RenderBody()
    </main>

    <footer class="site-footer container">
        Built with ASP.NET Core MVC &amp; Razor · &copy; @DateTime.Now.Year Ely
    </footer>

    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
